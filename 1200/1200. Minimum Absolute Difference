class Solution(object):
    def minimumAbsDifference(self, arr):
        """
        :type arr: List[int]
        :rtype: List[List[int]]
        """
        ans = []
        n = len(arr)

        arr.sort()

        minAbsDiff = float('inf')

        for i in range(n - 1):
            diff = abs(arr[i] - arr[i + 1])

            if diff < minAbsDiff:
                minAbsDiff = diff

        for i in range(n - 1):
            diff = arr[i + 1] - arr[i]

            if diff == minAbsDiff:
                ans.append([arr[i], arr[i + 1]])

        return ans

